# Replace every change-me value before exposing the service beyond localhost.
SOC_API_KEY=change-me-ingest-key
SOC_ADMIN_TOKEN=change-me-admin-token
POSTGRES_DB=soc
POSTGRES_USER=soc
POSTGRES_PASSWORD=change-this-db-password

SOC_HTTP_BIND=127.0.0.1
SOC_HTTP_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

SYSLOG_ENABLED=true
SYSLOG_BIND=0.0.0.0
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=5514
# Some OPNsense/pfSense versions default remote syslog to UDP/514.
# Docker forwards host SYSLOG_COMPAT_PORT to the in-container SYSLOG_PORT.
SYSLOG_COMPAT_BIND=0.0.0.0
SYSLOG_COMPAT_PORT=514
CORRELATION_WINDOW_SECONDS=300
ATTACK_MODEL_PATH=models/attack_classifier.json

# Optional local AI. Start with: docker compose --profile ai up -d
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=45

# dry_run | webhook | opnsense
RESPONSE_MODE=dry_run
RESPONSE_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_URL=
# After importing and activating n8n/workflows/a11_soc_local_automation.json:
# RESPONSE_MODE=webhook
# RESPONSE_WEBHOOK_URL=http://n8n:5678/webhook/a11-soc-response
# NOTIFICATION_WEBHOOK_URL=http://n8n:5678/webhook/a11-soc-alert

# OPNsense response adapter. Create a Host/Network/External alias named
# SOC_BLOCKLIST and a firewall rule that blocks this alias before enabling.
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_ALIAS=SOC_BLOCKLIST
OPNSENSE_VERIFY_TLS=true

# Optional Splunk Cloud/Enterprise search poller profile.
# Splunk Cloud REST API access may need to be enabled by Splunk Support.
SPLUNK_URL=
SPLUNK_TOKEN=
SPLUNK_AUTH_SCHEME=Bearer
SPLUNK_SEARCH=search index=main earliest=-90s | head 500
SPLUNK_POLL_INTERVAL_SECONDS=60
SPLUNK_VERIFY_TLS=true

# Optional n8n profile.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-key
N8N_PORT=5678
ALERT_EMAIL_TO=soc-analyst@a11.local
ALERT_EMAIL_FROM=a11-soc@a11.local
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=5000
